{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["addfox.config.ts", "app/**/*.ts", "app/**/*.tsx"]
	},
	"formatter": {
		"useEditorconfig": false,
		"indentWidth": 1,
		"lineEnding": "crlf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off",
				"noDoubleEquals": "warn"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	}
}
