{
  "name": "llm-streaming-translator",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "addfox dev --no-open --cache",
    "build": "rimraf .addfox/extension/ && addfox build --browser firefox --no-open && addfox build --browser chrome --no-open",
    "typecheck": "tsc --noEmit",
    "lint": "biome check app/",
    "lint:fix": "biome check --write app/",
    "format": "biome format --write app/",
    "format:check": "biome format app/",
    "zip:source": "rimraf .addfox/extension/source.zip && 7z a .addfox/extension/source.zip . -xr!node_modules -xr!.addfox -xr!dist -xr!*.zip -xr!.git"
  },
  "dependencies": {
    "@addfox/utils": "^0.2.5",
    "@nickyzj2023/utils": "^1.0.85",
    "solid-js": "^1.9.14",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@rsbuild/plugin-babel": "^2.0.1",
    "@rsbuild/plugin-solid": "^1.2.2",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@types/webextension-polyfill": "^0.12.5",
    "addfox": "^0.2.5",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
