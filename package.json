{
  "name": "llm-streaming-translator",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "addfox dev --no-open --cache",
    "build": "rimraf .addfox/extension/ && addfox build --browser firefox --no-open && addfox build --browser chrome --no-open",
    "typecheck": "tsc --noEmit",
    "lint": "biome check app/",
    "lint:fix": "biome check --write app/",
    "format": "biome format --write app/",
    "format:check": "biome format app/"
  },
  "dependencies": {
    "@addfox/utils": "^0.2.4",
    "@nickyzj2023/utils": "^1.0.75",
    "solid-js": "^1.9.13",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@rsbuild/plugin-babel": "^2.0.0",
    "@rsbuild/plugin-solid": "^1.2.2",
    "@types/chrome": "^0.1.43",
    "@types/webextension-polyfill": "^0.12.5",
    "addfox": "^0.2.4",
    "rimraf": "^5.0.0",
    "typescript": "^6.0.3"
  }
}
